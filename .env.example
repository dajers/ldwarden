# LDWarden configuration. Copy to .env; .env is ignored by git.
LDWARDEN_HOST=127.0.0.1
LDWARDEN_PORT=8000

# Authentication (optional, recommended for non-local use)
LDWARDEN_API_TOKEN=
LDWARDEN_CI_TOKEN=

# Сканирование разрешено только внутри этих каталогов.
# Для произвольной папки на своём компьютере добавьте её сюда.
LDWARDEN_ALLOWED_ROOTS=
# Явно разрешить сканировать любые локальные пути (только для доверенного окружения).
LDWARDEN_ALLOW_ARBITRARY_PATHS=false
# Абсолютные пути к локальным проектам (например, /home/user/project).
# Для публичного сервера поставьте false.
LDWARDEN_ALLOW_ABSOLUTE_PATHS=true

# Git clone support (for private repositories in the source node)
LDWARDEN_ALLOWED_GIT_HOSTS=github.com,gitlab.com
LDWARDEN_GIT_TOKEN=
LDWARDEN_GIT_USERNAME=x-access-token

# Telegram notifications
LDWARDEN_TELEGRAM_BOT_TOKEN=
LDWARDEN_TELEGRAM_CHAT_ID=

# Local LLM (CPU budget)
LDWARDEN_LLM_PROVIDER=auto
# Встроенный справочник; можно заменить своим путём.
LDWARDEN_VULN_DB=app/vulnerability-database/vulnerabilities.json
LDWARDEN_LLM_MODELS_DIR=llms
LDWARDEN_LLM_MODEL_PATH=llms/your-model.gguf
LDWARDEN_LLM_N_CTX=4096
LDWARDEN_LLM_THREADS=4
LDWARDEN_LLM_TIMEOUT=180

# Universal OpenAI-compatible API (OpenAI, OpenRouter, Groq, Ollama, LM Studio, ...)
# Use LDWARDEN_LLM_PROVIDER=openai or universal and fill the fields below.
LDWARDEN_LLM_BASE_URL=
LDWARDEN_LLM_API_KEY=
LDWARDEN_LLM_MODEL=
LDWARDEN_LLM_API_HEADERS=
LDWARDEN_LLM_AUTH_HEADER=Authorization
LDWARDEN_LLM_AUTH_PREFIX=Bearer

# GitHub preset library
LDWARDEN_LIBRARY_REPO=
LDWARDEN_LIBRARY_BRANCH=main
LDWARDEN_LIBRARY_PATH=presets
LDWARDEN_LIBRARY_TOKEN=

# Scheduler / demo
LDWARDEN_ENABLE_SCHEDULER=true
LDWARDEN_DEMO_INBOX=true
