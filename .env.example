# Скопируйте в .env и раскомментируйте нужное. Файл .env в git не попадает.
# Все переменные необязательны: без .env всё работает на значениях по умолчанию.

# --- сервер ---
# LDWARDEN_HOST=127.0.0.1
# LDWARDEN_PORT=8000
# LDWARDEN_API_TOKEN=            # включить авторизацию API
# LDWARDEN_CI_TOKEN=             # токен для POST /api/ci/run
# LDWARDEN_CORS_ORIGINS=*

# --- данные ---
# LDWARDEN_DATA_DIR=./data
# LDWARDEN_DEFAULT_TARGET=training-main/training-project
# LDWARDEN_VULN_DB=training-main/vulnerability-database/vulnerabilities.json

# --- AI (опционально; по умолчанию fallback без модели) ---
# LDWARDEN_LLM_PROVIDER=auto     # auto | local | ollama | openai | fake | none
# LDWARDEN_LLM_MODEL_PATH=llms/qwen2.5-coder-7b-instruct-q4_k_m.gguf
# LDWARDEN_LLM_N_CTX=16384   # 8192 мало для 15 находок
# LDWARDEN_LLM_THREADS=8
# LDWARDEN_LLM_MAX_FINDINGS=30
# LDWARDEN_LLM_TEMPERATURE=0.2
# LDWARDEN_LLM_BASE_URL=         # для openai/ollama, например http://127.0.0.1:1234/v1
# LDWARDEN_LLM_MODEL=            # id модели у провайдера
# LDWARDEN_LLM_API_KEY=

# --- git-источники (по умолчанию отключены) ---
# LDWARDEN_ALLOWED_GIT_HOSTS=github.com,gitlab.com
# LDWARDEN_GIT_TOKEN=
# LDWARDEN_GIT_USERNAME=x-access-token

# --- уведомления ---
# LDWARDEN_TELEGRAM_BOT_TOKEN=
# LDWARDEN_TELEGRAM_CHAT_ID=

# --- планировщик ---
# LDWARDEN_ENABLE_SCHEDULER=0
# LDWARDEN_SCHEDULER_INTERVAL=30
# LDWARDEN_SCHEDULER_TZ=UTC

# --- лимиты и отладка ---
# LDWARDEN_MAX_FILES=20000
# LDWARDEN_MAX_FILE_BYTES=2097152
# LDWARDEN_LOG_LEVEL=INFO
